{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "summary", "assumptions", "tasks", "acceptance_criteria"],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "objective", "kind", "owned_paths", "excluded_paths",
          "interfaces", "constraints", "verification", "depends_on", "risk", "tags",
          "allow_deletions", "allow_production_changes", "commit_message"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "kind": {"enum": ["recon", "documentation", "test", "implementation", "refactor", "bugfix", "migration", "security", "operations"]},
          "owned_paths": {"type": "array", "items": {"type": "string"}},
          "excluded_paths": {"type": "array", "items": {"type": "string"}},
          "interfaces": {"type": "array", "items": {"type": "string"}},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "verification": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "success", "timeout_seconds"],
              "properties": {
                "command": {"type": "string", "minLength": 1},
                "success": {"type": "string", "minLength": 1},
                "timeout_seconds": {"type": ["integer", "null"], "minimum": 1}
              }
            }
          },
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "tags": {"type": "array", "items": {"type": "string"}},
          "allow_deletions": {"type": "boolean"},
          "allow_production_changes": {"type": "boolean"},
          "commit_message": {"type": ["string", "null"]}
        }
      }
    }
  }
}
